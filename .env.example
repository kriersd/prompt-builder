# ─── Anthropic / Claude ───────────────────────────────────────────────────────
# Required: your Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use for prompt generation and analysis
# Options: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Optional: protects AI and write endpoints when set.
# Send as Authorization: Bearer <token> or x-api-token.
APP_API_TOKEN=

# Optional: comma-separated origins allowed to call the API cross-origin.
# Leave empty to disable cross-origin API access.
CORS_ORIGIN=

# Set to true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false

# ─── Database ─────────────────────────────────────────────────────────────────
# DB_TYPE=json         → local JSON files (default, no extra setup)
# DB_TYPE=mongodb      → MongoDB (requires MONGODB_URI and `npm install mongodb`)
DB_TYPE=json

# Local JSON database directory (relative or absolute path)
DATA_DIR=./app/data

# MongoDB connection (only used when DB_TYPE=mongodb)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=promptforge
